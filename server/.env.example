# ---- Required in production ----

# PostgreSQL connection string from your hosted database provider.
# Local development uses postgresql://pguser:pgpass@127.0.0.1:55432/pgmanager
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string. Signing key for login sessions.
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Port the server listens on. Most hosts set this for you.
PORT=4000

NODE_ENV=production

# Public origin of the deployed site, used for links inside emails.
PUBLIC_URL="https://your-app.example.com"

# Origin allowed to call the API from a browser. Same value as PUBLIC_URL
# when the API and the website are served together (the default setup).
CLIENT_ORIGIN="https://your-app.example.com"

# Where resident photos and documents are written. Must be a writable path.
UPLOADS_DIR=uploads

# ---- Email (optional: without these, mail is logged instead of sent) ----
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PG Manager <no-reply@pgmanager.app>"
TEAM_INBOX=""
